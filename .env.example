# Standalone Agentropolis. Offline simulation is the default; secrets stay server-side.
AGENTROPOLIS_HOST=127.0.0.1
AGENTROPOLIS_PORT=8001
AGENTROPOLIS_FRONTEND_ORIGIN=http://127.0.0.1:5173
AGENTROPOLIS_CORS_ORIGINS=http://127.0.0.1:5173
AGENTROPOLIS_STORE=sqlite
AGENTROPOLIS_DATA_DIR=backend/.data
AGENTROPOLIS_SEED=13
AGENTROPOLIS_LLM_MODE=replay

# Optional Claude reasoning. API billing is separate from chat subscriptions.
ANTHROPIC_API_KEY=
# Legacy alias also supported by the gateway
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_MAX_TOKENS=400
CLAUDE_TIMEOUT_SECONDS=12
CLAUDE_MAX_CALLS=30
# 100000 microdollars = $0.10 per gateway lifetime; each attempt reserves cost.
CLAUDE_BUDGET_MICRODOLLARS=100000
CLAUDE_INPUT_USD_PER_MTOK=0.10
CLAUDE_OUTPUT_USD_PER_MTOK=0.50
LLM_PROVIDER=claude
ASI1_API_KEY=
ASI1_MODEL=asi1

# Public registration is opt-in in BusinessAgentEndpoint; these alone do not enable it.
AGENTVERSE_KEY=
GATEWAY_SEED=
GATEWAY_PORT=9510
FETCH_AGENT_SEED=
FETCH_PUBLIC_ENDPOINT=

# Nessie is fake-money banking only. Verification script defaults to read-only.
NESSIE_MODE=mock
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com
NESSIE_ACCOUNT_ID=

# Distinct digital-service buyer. Simulation never chooses this client automatically.
X402_MODE=mock
X402_NETWORK=base-sepolia
X402_RESOURCE_URL=
X402_PAY_TO=
X402_WALLET_PRIVATE_KEY=
X402_PER_CALL_CAP_CENTS=100
X402_DAILY_CAP_CENTS=500

# Read a previously completed Actor dataset; no Actor is launched automatically.
APIFY_MODE=fixture
APIFY_API_TOKEN=
APIFY_ACTOR_ID=
CRS_MODE=mock
CRS_API_KEY=
# Optional future evaluation, not connected to the SQLite authoritative store.
SPACETIMEDB_URI=http://127.0.0.1:3000
SPACETIMEDB_DATABASE=agentropolis
