# Standalone Agentropolis configuration
AGENTROPOLIS_HOST=127.0.0.1
AGENTROPOLIS_PORT=8001
AGENTROPOLIS_FRONTEND_ORIGIN=http://127.0.0.1:5173
AGENTROPOLIS_CORS_ORIGINS=http://127.0.0.1:5173
AGENTROPOLIS_STORE=sqlite
AGENTROPOLIS_DATA_DIR=backend/.data
AGENTROPOLIS_SEED=13
AGENTROPOLIS_LLM_MODE=replay

# Optional reasoning providers
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-haiku-20241022
CLAUDE_MAX_TOKENS=400
CLAUDE_TIMEOUT_SECONDS=12
ASI1_API_KEY=your_asi1_api_key_here
ASI1_MODEL=asi1
LLM_PROVIDER=claude

# Optional sponsor adapters; none are required for the offline demo
AGENTVERSE_KEY=your_agentverse_key_here
GATEWAY_SEED=agentropolis_gateway_seed_2026
GATEWAY_PORT=9510
NESSIE_MODE=mock
NESSIE_API_KEY=your_nessie_sandbox_key_here
NESSIE_BASE_URL=https://api.nessieisreal.com
X402_MODE=mock
X402_NETWORK=base-sepolia
X402_WALLET_PRIVATE_KEY=your_throwaway_testnet_wallet_private_key_here
X402_DAILY_CAP_CENTS=10000
APIFY_MODE=fixture
APIFY_API_TOKEN=your_apify_token_here
APIFY_ACTOR_ID=your_apify_actor_id_here
CRS_MODE=mock
CRS_API_KEY=your_crs_sandbox_key_here
SPACETIMEDB_URI=http://127.0.0.1:3000
SPACETIMEDB_DATABASE=agentropolis
